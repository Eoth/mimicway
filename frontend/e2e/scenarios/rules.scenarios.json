        { "action": "click", "target": "ruleList.addButton" },
        { "action": "fill", "target": "ruleForm.nameInput", "value": "scenario-simple-rule" },
        { "action": "screenshot", "file": "rule-create-form.png", "target": ["ruleForm.nameInput", "ruleForm.actionMockOption"] },
        { "action": "click", "target": "ruleForm.submitButton" },
        { "action": "assertVisible", "target": "ruleList.item", "params": { "name": "scenario-simple-rule" } }
      ]
    },
