{
  "name": "mimicway-frontend",
  "version": "0.1.0",
  "description": "Web interface of Mimicway, served as static files by its binary",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/Eoth/mimicway",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "docs:screenshots": "npx playwright test --config=playwright.docs-screenshots.config.js",
    "design:preview": "vite --open /design-preview.html"
  },
  "dependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^29.1.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  }
}
