{
  "name": "mimicway-frontend",
  "version": "0.2.0",
  "description": "Web interface of Mimicway, served as static files by its binary",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/Eoth/mimicway",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "docs:screenshots": "npx playwright test --config=playwright.docs-screenshots.config.js",
    "design:preview": "vite --open /design-preview.html",
    "format": "prettier --config prettier.config.js --write . ../scripts",
    "format:check": "prettier --config prettier.config.js --check . ../scripts"
  },
  "dependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
