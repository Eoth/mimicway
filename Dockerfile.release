# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# The release image, assembled by .github/workflows/release.yml from the static Linux binaries it built and attested,
# with the same content and settings as the Dockerfile: the binary and an empty data directory, no operating system.
# There is no RUN step, so the arm64 image needs no emulation to build.
FROM scratch
ARG TARGETARCH
COPY --chown=1000:1000 data /data
COPY --chmod=0755 linux-${TARGETARCH}/mimicway /app/mimicway
WORKDIR /app
USER 1000:1000
# Every interface of the container: its network is the boundary. Publish the port on the host's loopback
# (-p 127.0.0.1:7342:7342) unless authentication is on.
ENV DATA_PATH=/data PORT=7342 BIND_ADDRESS=0.0.0.0
EXPOSE 7342
ENTRYPOINT ["/app/mimicway"]
